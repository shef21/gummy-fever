# Copy this file to .env.local and fill in your values.
# Never commit real keys. Never expose YOCO_SECRET_KEY, YOCO_WEBHOOK_SECRET,
# or SUPABASE_SERVICE_ROLE_KEY to the browser.

# Supabase → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to create orders and apply Yoco webhooks (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used for Yoco success/cancel/failure return URLs.
# Local: http://localhost:3000
# Production: https://gummyfever.com
NEXT_PUBLIC_SITE_URL=

# Yoco Checkout API — server-only. Test keys start with sk_test_.
# Yoco App → Checkout API → How to connect → Test keys
YOCO_SECRET_KEY=

# Shown once when you register the webhook. Starts with whsec_.
YOCO_WEBHOOK_SECRET=
