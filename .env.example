# Copy this file to .env.local and fill in your values.
# Never commit real keys. Never expose PAYSTACK_SECRET_KEY or
# SUPABASE_SERVICE_ROLE_KEY to the browser.

# Supabase → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to create orders and apply Paystack webhooks (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used for Paystack callback_url.
# Local: http://localhost:3000
# Production: https://gummyfever.com
NEXT_PUBLIC_SITE_URL=

# Paystack — server-only. Dashboard → Settings → API Keys & Webhooks.
# Test keys start with sk_test_. Live keys start with sk_live_.
PAYSTACK_SECRET_KEY=

# Not used by this integration (hosted redirect, not Paystack Inline).
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
